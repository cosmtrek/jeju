    <script>
      // ---- copy buttons ----
      for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
        btn.addEventListener("click", async () => {
          const code = btn.closest("[data-copy-scope]")?.querySelector("code");
          if (!code) return;
          const text = code.innerText.replace(/^[$›]\s*/, "");
          try {
            await navigator.clipboard.writeText(text);
            btn.textContent = "copied";
            btn.classList.add("copied");
            setTimeout(() => {
              btn.textContent = "copy";
              btn.classList.remove("copied");
            }, 1500);
          } catch {
            btn.textContent = "select & copy";
          }
        });
      }

      // ---- scroll reveal ----
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const targets = document.querySelectorAll("[data-reveal]");
      if (reduced || !("IntersectionObserver" in window)) {
        for (const el of targets) el.classList.add("in");
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("in");
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: "0px 0px -6% 0px" },
        );
        for (const el of targets) io.observe(el);
      }

      // ---- hero run replay ----
      // Types the request, then streams the run's events, then loops.
      // Without JS or with reduced motion the finished run renders statically
      // (the `replay-anim` class is only added when animation is wanted).
      const replay = document.querySelector<HTMLElement>("[data-replay]");
      if (replay && document.documentElement.classList.contains("replay-anim")) {
        const lines = [...replay.querySelectorAll<HTMLElement>(".rl")];
        const typed = replay.querySelector<HTMLElement>(".type");
        const fullText = typed?.dataset.text ?? "";
        const delayAfter = [300, 550, 500, 450, 460, 430, 430, 620, 520, 0];
        const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

        const cycle = async () => {
          replay.classList.remove("done");
          for (const l of lines) l.classList.remove("on");
          if (typed) typed.textContent = "";
          await sleep(600);
          for (let i = 0; i < lines.length; i++) {
            lines[i].classList.add("on");
            if (i === 0 && typed) {
              for (const ch of fullText) {
                typed.textContent += ch;
                await sleep(26);
              }
            }
            await sleep(delayAfter[i] ?? 400);
          }
          replay.classList.add("done");
          await sleep(4600);
        };

        (async () => {
          // eslint-disable-next-line no-constant-condition
          while (true) await cycle();
        })();
      }
    </script>

