      .router-row {
        display: grid;
        grid-template-columns: minmax(0, 1.25fr) 32px minmax(0, 1.3fr) minmax(0, 0.85fr);
        gap: 6px 16px;
        align-items: baseline;
        padding: 16px 20px;
      }

      .router-row + .router-row {
        border-top: 1px solid var(--line);
      }

      .router-row:not(.router-head):hover {
        background: var(--panel);
      }

      .router-head {
        padding-top: 11px;
        padding-bottom: 10px;
        color: var(--faint);
        font-family: var(--mono);
        font-size: 0.68rem;
        font-weight: 500;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .router-ask {
        font-size: 0.98rem;
        font-weight: 500;
      }

      .router-arrow {
        color: var(--accent);
        text-align: center;
      }

      .router-worker {
        font-family: var(--mono);
        font-size: 0.8rem;
        overflow-wrap: anywhere;
      }

      .router-returns {
        color: var(--muted);
        font-size: 0.88rem;
      }

      .router-note {
        grid-column: 3 / -1;
        margin: 4px 0 0;
        color: var(--faint);
        font-size: 0.85rem;
        line-height: 1.55;
      }

      /* ---------- rules ---------- */
      .rules {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: clamp(24px, 3.5vw, 48px);
        margin-top: clamp(36px, 5vw, 56px);
      }

      .rules h3 {
        font-size: 0.98rem;
        margin-bottom: 10px;
      }

      .rules p {
        margin: 0;
        color: var(--muted);
        font-size: 0.9rem;
        line-height: 1.62;
      }

      /* ---------- demo ---------- */
      .demo {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1px;
        margin-top: clamp(36px, 5vw, 56px);
        border: 1px solid var(--line);
        border-radius: 2px;
        overflow: hidden;
        background: var(--line);
      }

      .demo-col {
        min-width: 0;
        padding: 16px 20px 18px;
        background: var(--panel);
      }

      .demo-label {
        margin: 0 0 12px;
        color: var(--faint);
        font-family: var(--mono);
        font-size: 0.68rem;
        font-weight: 500;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .demo-col pre {
        margin: 0;
        overflow-x: auto;
      }

      .demo-col code {
        font-size: 0.8rem;
        line-height: 1.65;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        color: var(--muted);
      }

      /* ---------- internals ---------- */
      .internals-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
        gap: clamp(24px, 4vw, 48px);
        align-items: center;
        margin-top: clamp(36px, 5vw, 56px);
      }

      .registry-yaml {
        margin: 0;
        padding: 18px 20px;
        border: 1px solid var(--line);
        border-radius: 2px;
        background: var(--panel);
        overflow-x: auto;
      }

      .registry-yaml code {
        font-size: 0.78rem;
        line-height: 1.65;
        white-space: pre;
        color: var(--muted);
      }

      .internals-note p {
        margin: 0;
        color: var(--muted);
        font-size: 0.96rem;
        line-height: 1.7;
      }

      .internals-note code {
        color: var(--fg);
        font-size: 0.82rem;
      }

      /* ---------- package table ---------- */
      .pkg-table {
        width: 100%;
        margin-top: clamp(36px, 5vw, 56px);
        border-collapse: collapse;
        font-size: 0.9rem;
      }

      .pkg-table th {
        padding: 0 24px 10px 0;
        border-bottom: 1px solid var(--line-strong);
        color: var(--faint);
        font-family: var(--mono);
        font-size: 0.68rem;
        font-weight: 500;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        text-align: left;
      }

      .pkg-table th:nth-child(1) {
        width: 42%;
      }

      .pkg-table th:nth-child(2) {
        width: 21%;
      }

      .pkg-table th:nth-child(3) {
        width: 27%;
      }

      .pkg-table th:last-child,
      .pkg-table td:last-child {
        width: 10%;
        padding-right: 0;
        text-align: right;
      }

      .pkg-table td {
        padding: 16px 24px 16px 0;
        border-bottom: 1px solid var(--line);
        vertical-align: top;
      }

      .pkg-table tbody tr:hover {
        background: color-mix(in oklab, var(--panel) 60%, transparent);
      }

      .pkg-name {
        display: block;
        margin-bottom: 4px;
        font-family: var(--mono);
        font-size: 0.82rem;
        font-weight: 500;
      }

      .pkg-desc {
        display: block;
        max-width: 52ch;
        color: var(--muted);
        font-size: 0.85rem;
        line-height: 1.5;
      }

      td.mono {
        font-family: var(--mono);
        font-size: 0.78rem;
        color: var(--muted);
        white-space: nowrap;
      }

      /* ---------- footer ---------- */
      footer {
        width: var(--w);
        margin: 26px auto 0;
        padding: 12px 0 52px;
        display: flex;
        flex-wrap: wrap;
        gap: 24px 48px;
        justify-content: space-between;
        align-items: center;
      }

      .signature {
        margin: 0;
        color: var(--faint);
        font-size: 0.88rem;
        line-height: 1.65;
      }

      .signature a {
        color: var(--fg);
        font-weight: 600;
        border-bottom-color: var(--line-strong);
      }

      .signature a:hover {
        border-bottom-color: var(--accent);
      }

      footer nav {
        display: flex;
        flex-wrap: wrap;
        gap: 10px 22px;
        font-size: 0.85rem;
      }

      footer a {
        border-bottom-color: var(--line);
      }

      footer nav a {
        color: var(--muted);
        border: none;
      }

      footer nav a:hover {
        color: var(--fg);
      }

      /* ---------- pipeline flow ---------- */
      .flow {
        position: relative;
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 20px;
        margin: clamp(40px, 5.5vw, 64px) 0 0;
        padding: 0;
        list-style: none;
      }

      /* the dashed route the stations sit on */
      .flow::before {
        content: "";
        position: absolute;
        top: 6px;
        left: 4px;
        right: 14px;
        border-top: 2px dashed var(--line-strong);
      }

      .flow::after {
        content: "";
        position: absolute;
        top: 1.5px;
        right: 2px;
        border-left: 9px solid var(--accent);
        border-top: 5.5px solid transparent;
        border-bottom: 5.5px solid transparent;
      }

      .flow-node {
        position: relative;
        display: grid;
        justify-items: start;
        gap: 4px;
        min-width: 0;
      }

      .flow-dot {
        width: 13px;
        height: 13px;
        margin-bottom: 10px;
        border: 2.5px solid var(--accent);
        border-radius: 50%;
        background: var(--bg);
        box-shadow: 0 0 0 4px var(--bg);
      }

      .flow-label {
        font-family: var(--mono);
        font-size: 0.86rem;
        font-weight: 600;
        overflow-wrap: anywhere;
      }

      .flow-sub {
        color: var(--muted);
        font-size: 0.84rem;
      }

      /* ---------- report card ---------- */
      .report-wrap {
        display: grid;
        grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
        gap: clamp(28px, 4.5vw, 64px);
        align-items: center;
        margin-top: clamp(44px, 6vw, 72px);
      }

      .report {
        position: relative;
        padding: 16px 22px 14px;
        border: 1px solid var(--line);
        border-radius: 3px;
        background: oklch(98.5% 0.007 90);
        box-shadow: 0 20px 44px -32px oklch(30% 0.03 60 / 0.6);
        font-family: var(--mono);
      }

      .report-head {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 4px 16px;
        padding-bottom: 10px;
        border-bottom: 1px solid var(--line);
        color: var(--faint);
        font-size: 0.7rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .report-title {
        color: var(--fg);
        font-weight: 600;
      }

      .report-sum {
        display: flex;
        flex-wrap: wrap;
        gap: 4px 22px;
        padding: 11px 0;
        border-bottom: 1px solid var(--line);
        color: var(--faint);
        font-size: 0.76rem;
      }

      .report-sum b {
        color: var(--fg);
        font-weight: 500;
      }

      .report-sum b.deny {
        color: var(--accent);
      }

      .report-rows {
        display: grid;
        gap: 9px;
        padding: 13px 0 11px;
      }

      .report-row {
        display: grid;
        grid-template-columns: 7em minmax(0, 14em) minmax(0, 1fr) 5.5em;
        gap: 12px;
        align-items: center;
        font-size: 0.74rem;
      }

      .report-kind {
        color: var(--faint);
      }

      .report-label {
        color: var(--fg);
        overflow-wrap: anywhere;
      }

      .report-bar {
        width: var(--w);
        height: 7px;
        border-radius: 2px;
        background: oklch(60% 0.02 60);
      }

      .report-bar.is-tool {
        background: var(--sea);
      }

      .report-bar.is-deny {
        background: var(--accent);
      }

      .report-bar.is-final {
        background: var(--accent-fill);
      }

      .report-state {
        font-size: 0.66rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        text-align: right;
      }

      .report-state.ok {
        color: var(--sea);
      }

      .report-state.deny {
        color: var(--accent);
      }

      .report-foot {
        padding-top: 10px;
        border-top: 1px solid var(--line);
        color: var(--faint);
        font-size: 0.72rem;
      }

      .report-note p {
        margin: 0;
        color: var(--muted);
        font-size: 0.96rem;
        line-height: 1.7;
      }

      .report-note code {
        color: var(--fg);
        font-size: 0.82rem;
      }

      /* the harbor stamp */
      .stamp {
        position: absolute;
        bottom: -36px;
        right: -30px;
        width: 108px;
        color: var(--accent);
        opacity: 0.75;
        transform: rotate(-8deg);
        mix-blend-mode: multiply;
        pointer-events: none;
      }

      .stamp text {
        fill: currentColor;
        font-family: var(--mono);
        font-weight: 600;
      }

      /* ---------- coastline footer divider ---------- */
      .coast {
        width: var(--w);
        margin: clamp(72px, 10vw, 136px) auto 0;
        text-align: center;
      }

      .coast svg {
        display: block;
        width: 100%;
        height: 22px;
        color: var(--line-strong);
      }

      .coast-label {
        display: inline-block;
        margin-top: 10px;
        color: var(--faint);
        font-family: var(--mono);
        font-size: 0.66rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      /* ---------- responsive ---------- */
      @media (max-width: 1020px) {
        .replay-body {
          font-size: 0.8rem;
          min-height: 0;
        }

        .contours {
          mask-image: radial-gradient(120% 70% at 80% 20%, black 30%, transparent 72%);
        }
      }

      @media (max-width: 900px) {
        .cols,
        .rules,
        .steps li,
        .demo {
          grid-template-columns: 1fr;
        }

        .internals-grid,
        .anatomy,
        .report-wrap,
        .builder-grid {
          grid-template-columns: 1fr;
        }

        .flow {
          grid-template-columns: 1fr;
          gap: 22px;
          padding-left: 4px;
        }

        /* route runs vertically on small screens */
        .flow::before {
          top: 6px;
          bottom: 4px;
          left: 9.5px;
          right: auto;
          border-top: none;
          border-left: 2px dashed var(--line-strong);
        }

        .flow::after {
          top: auto;
          bottom: -4px;
          left: 5.5px;
          right: auto;
          border-top: 9px solid var(--accent);
          border-left: 5.5px solid transparent;
          border-right: 5.5px solid transparent;
          border-bottom: none;
        }

        .flow-node {
          grid-template-columns: 24px minmax(0, 1fr);
          grid-template-rows: auto auto;
          column-gap: 12px;
        }

        .flow-dot {
          grid-row: 1 / 3;
          margin-top: 2px;
          margin-bottom: 0;
        }

        .flow-label,
        .flow-sub {
          grid-column: 2;
        }

        .stamp {
          bottom: -20px;
          right: -6px;
          width: 88px;
        }

        .report-row {
          grid-template-columns: 6em minmax(0, 1fr) 5em;
        }

        .report-bar {
          display: none;
        }

        .router-head {
          display: none;
        }

        .router-row {
          grid-template-columns: 1fr;
          gap: 4px;
          padding: 16px 18px;
        }

        .router-arrow {
          display: none;
        }

        .router-note {
          grid-column: 1;
        }
      }

      @media (max-width: 720px) {
        .nav {
          padding: 0 20px;
        }

        .nav nav {
          gap: 16px;
        }

        /* keep the two links that matter on small screens */
        .nav nav a:not([href="#quickstart"]):not([href^="https://github"]) {
          display: none;
        }

        .pkg-table thead {
          display: none;
        }

        .pkg-table,
        .pkg-table tbody,
        .pkg-table tr,
        .pkg-table td {
          display: block;
        }

        .pkg-table tr {
          padding: 14px 0;
          border-bottom: 1px solid var(--line);
        }

        .pkg-table td {
          padding: 3px 0;
          border: none;
        }

        .pkg-table td:last-child {
          width: auto;
          text-align: left;
        }

        td.mono {
          white-space: normal;
        }
      }
    </style>
  </body>
</html>
