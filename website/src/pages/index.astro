---
import packages from "../data/catalog.generated.json";

const registryUrl = "https://jeju.rickoyu.com/registry/index.yaml";
const siteUrl = "https://jeju.rickoyu.com/";

const installCmd = "npx skills add cosmtrek/jeju --skill jeju-writing -g";
const agentPrompt = "Review ~/drafts/launch-post.md for publish readiness.";
const viewCmd = "jeju view 20260708-a41f";

const builderInstall = "npx skills add cosmtrek/jeju --skill jeju-agent-builder -g";
const builderAsk = "Turn my changelog drafting into a jeju agent.";
const builderTree = `changelog-drafter/
├── agents/
│   └── changelog-drafter.agent.yaml
├── prompts/
│   └── changelog-drafter.md
├── workspace/
├── eval/                # smoke evaluator
└── README.md

$ jeju validate agents/changelog-drafter.agent.yaml
✓ manifest ok · readOnly · maxSteps 16
$ jeju run … "Draft the changelog for last week."
✓ run 20260708-c7e2 · $0.002`;

const manifestSnippet = `kind: Agent
metadata:
  name: article-editor
models:
  providers:
    primary:
      preset: deepseek
      model: deepseek-v4-pro
      temperature: 0.1
instructions:
  system: prompts/article-editor.md
tools: [read, search]
permissions:
  access: readOnly
runtime:
  limits: { maxSteps: 24, maxToolCalls: 40 }
output:
  name: editorial_review
  schema: # verdict, findings[]…`;

const pillars = [
  {
    key: "manifest",
    title: "An agent is a manifest",
    body: "Model, prompt, tools, permissions, limits, output schema — one YAML file, fully inspectable. No behavior hidden in code.",
  },
  {
    key: "boundary",
    title: "Every run is bounded",
    body: "Each tool call passes a policy gate. File access stays inside the declared workspace. Step and cost limits are enforced, not suggested.",
  },
  {
    key: "evidence",
    title: "Every run leaves evidence",
    body: "trajectory.jsonl records model calls, tool calls, policy decisions, and artifacts. jeju view renders it as a report.",
  },
  {
    key: "package",
    title: "Agents ship as packages",
    body: "Versioned, digest-verified, installed by reference from a static registry. The same worker, reproducible on any machine.",
  },
];

const problems = [
  {
    num: "a",
    title: "Frontier models doing grunt work",
    body: "Your orchestrator rewrites and translates at frontier prices. Jeju splits the bill: your model plans and reviews; cheap specialists execute.",
  },
  {
    num: "b",
    title: "Prompted behavior drifts",
    body: "A prompt is advice — it behaves differently across sessions and models. A manifest is pinned: model, temperature, tools, limits. Identical next month.",
  },
  {
    num: "c",
    title: "Chat logs are not evidence",
    body: "When delegated work goes wrong, a conversation tells you nothing. A run files trajectory.jsonl — every tool call gated, every decision recorded.",
  },
];

const pipeline = [
  { label: "agent.yaml", sub: "declare the worker" },
  { label: "compile", sub: "validate & pin" },
  { label: "run", sub: "every call policy-gated" },
  { label: "trajectory.jsonl", sub: "the canonical record" },
  { label: "jeju view", sub: "render the report" },
];

const reportRows = [
  { kind: "model.call", label: "plan review pass", w: 58, cls: "", state: "" },
  { kind: "tool.call", label: "read launch-post.md", w: 16, cls: "is-tool", state: "allow" },
  { kind: "tool.call", label: "read ../notes/ideas.md", w: 7, cls: "is-deny", state: "deny" },
  { kind: "model.call", label: "compose findings", w: 86, cls: "", state: "" },
  { kind: "final.answer", label: "editorial_review", w: 11, cls: "is-final", state: "schema ok" },
];

const routes = [
  {
    ask: "“Translate this abstract.”",
    worker: "writing/translator",
    returns: "translated text",
  },
  {
    ask: "“这段中文帮我改自然一点。”",
    worker: "writing/chinese-expression-polisher",
    returns: "polished draft",
  },
  {
    ask: "“Rewrite this for a technical audience.”",
    worker: "writing/article-rewriter",
    returns: "revised draft",
  },
  {
    ask: "“Is this ready to publish?”",
    worker: "writing/article-editor",
    returns: "verdict + findings, JSON",
    note: "You pick the findings worth fixing. The skill dispatches the rewriter or polisher with exactly those.",
  },
];

const practices = [
  {
    title: "Humans pick the findings",
    body: "No rewriting on autopilot. Review findings go to the author; only the accepted subset becomes the next worker's task.",
  },
  {
    title: "The boundary stays explicit",
    body: "Workers run read-only inside a policy-gated workspace. They return text — they never touch your files.",
  },
  {
    title: "Verify the run, not the vibe",
    body: "Every step prints a run id. jeju view opens the report: what was read, what was denied, what it cost. Failed runs exit non-zero.",
  },
];

const reviewCmd = `jeju run --workspace ~/drafts --from ~/drafts/draft.md \\
  p:writing/article-editor@0.1.0 \\
  "Review this draft for publish readiness. Return only the configured JSON."`;

const reviewOut = `{
  "verdict": "needs_revision",
  "summary": "Clear thesis, but the argument is asserted rather than built.",
  "findings": [
    {
      "severity": "high",
      "location": "opening paragraph",
      "issue": "The central claim is stated as absolute but never defended.",
      "suggestion": "Soften the claim or add a concrete comparison."
    }
  ]
}`;

const registryEntry = `packages:
  writing/article-editor:
    versions:
      0.1.0:
        source: github:cosmtrek/jeju//catalog/writing/article-editor?ref=<commit>
        digest: sha256:966d…6aff`;

const replayJson = `{ "verdict": "needs_revision", "findings": 3 }`;

const orderedPackages = [...packages].sort((a, b) => a.id.localeCompare(b.id));

// --- tiny build-time highlighters (keys only, restraint on purpose) ---
const esc = (s: string) =>
  s.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;");

const hlYaml = (src: string) =>
  src
    .split("\n")
    .map((line) => {
      const m = line.match(/^(\s*)([\w-]+)(:)(.*)$/);
      if (!m) return esc(line);
      const rest = esc(m[4]).replace(/#.*$/, (c) => `<span class="hc">${c}</span>`);
      return `${m[1]}<span class="hk">${m[2]}</span>:${rest}`;
    })
    .join("\n");

const hlJson = (src: string) =>
  esc(src).replace(/"([^"]+)":/g, '<span class="hk">"$1"</span>:');

// --- Hallasan contour lines, generated at build time ---
// One wobbly base shape, scaled per ring, so contours nest like real topography.
function islandContours(cx: number, cy: number, radii: number[]) {
  const points = 12;
  let s = 20260708;
  const rand = () => {
    s = (s * 16807) % 2147483647;
    return s / 2147483647;
  };
  const mult = Array.from({ length: points }, () => 1 + (rand() - 0.5) * 0.44);
  return radii.map((r) => {
    const jitter = 1 + (rand() - 0.5) * 0.05;
    const pts = mult.map((m, i) => {
      const a = (i / points) * Math.PI * 2;
      return [
        cx + Math.cos(a) * r * m * jitter * 1.35,
        cy + Math.sin(a) * r * m * jitter,
      ];
    });
    let d = `M ${pts[0][0].toFixed(1)} ${pts[0][1].toFixed(1)}`;
    for (let i = 0; i < points; i++) {
      const p0 = pts[(i - 1 + points) % points];
      const p1 = pts[i];
      const p2 = pts[(i + 1) % points];
      const p3 = pts[(i + 2) % points];
      const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
      const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
      d += ` C ${c1[0].toFixed(1)} ${c1[1].toFixed(1)}, ${c2[0].toFixed(1)} ${c2[1].toFixed(1)}, ${p2[0].toFixed(1)} ${p2[1].toFixed(1)}`;
    }
    return d + " Z";
  });
}
const contourPaths = islandContours(950, 300, [42, 88, 142, 204, 274, 352]);

// gentle coastline wave for the footer divider
const coastPath =
  "M 0 11 Q 30 4, 60 11 " +
  Array.from({ length: 19 }, (_, i) => `T ${120 + i * 60} 11`).join(" ");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Jeju — hire a workforce for your coding agent</title>
    <meta
      name="description"
      content="Jeju gives your coding agent bounded, cheap, auditable workers. Install one skill; your agent routes writing work to pinned specialists and files evidence for every run."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#fcfcfb" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Jeju — hire a workforce for your coding agent" />
    <meta
      property="og:description"
      content="Bounded, cheap, auditable workers for your coding agent. One skill to install; evidence filed for every run."
    />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={`${siteUrl}og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:ital,wght@0,400..900;1,400..900&family=Sometype+Mono:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Gate the replay animation before first paint: no JS or reduced motion
      // means the finished run renders statically.
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("replay-anim");
      }
    </script>
  </head>
  <body>
    <header class="nav">
      <a class="wordmark" href="#top">jeju<span class="wordmark-dot" aria-hidden="true"></span></a>
      <nav>
        <a href="#product">What it is</a>
        <a href="#pipeline">Pipeline</a>
        <a href="#quickstart">Quickstart</a>
        <a href="#builder">Build</a>
        <a href="#skill">Writing team</a>
        <a href="#registry">Registry</a>
        <a href="https://github.com/cosmtrek/jeju">GitHub ↗</a>
      </nav>
    </header>

    <main id="top">
      <!-- ================= HERO ================= -->
      <section class="hero">
        <svg
          class="contours"
          viewBox="0 0 1440 620"
          preserveAspectRatio="xMidYMid slice"
          aria-hidden="true"
        >
          {contourPaths.map((d, i) => (
            <path d={d} class={i < 2 ? "ring ring-inner" : "ring"} />
          ))}
          <path class="summit" d="M 950 293 l 5.5 10 h -11 z" />
          <text class="summit-label" x="963" y="303">1947</text>
        </svg>

        <div class="hero-copy">
          <p class="tag" data-reveal>Open-source agent runtime — Go, local-first</p>
          <h1 data-reveal>Hire a workforce<br />for your coding agent.</h1>
          <p class="lede" data-reveal>
            Jeju turns agents into installable workers — pinned manifest,
            policy-gated workspace, evidence for every run. Your agent plans;
            cheap bounded specialists execute; you audit.
          </p>
          <div class="cta" data-reveal>
            <a class="btn btn-solid" href="#quickstart">Get started</a>
            <a class="btn btn-ghost" href="https://github.com/cosmtrek/jeju">Star on GitHub</a>
          </div>
          <p class="proof" data-reveal>
            Dogfooded, not demoed — the four launch workers run the author's
            own writing pipeline.
          </p>
        </div>

        <figure class="replay" data-reveal aria-label="Replay of a Jeju run: a review request is routed to a worker, tool calls pass the policy gate, and the run files evidence.">
            <figcaption class="replay-bar">
              <span class="replay-pip" aria-hidden="true"></span>
              <span>run replay</span>
              <span class="replay-bar-right">jeju-writing</span>
            </figcaption>
            <div class="replay-body" data-replay>
              <p class="rl rl-prompt">
                <span class="rp">›&nbsp;</span><span class="type" data-text={agentPrompt}>{agentPrompt}</span><span class="caret" aria-hidden="true"></span>
              </p>
              <p class="rl rl-dim">jeju-writing · routed → writing/article-editor@0.1.0</p>
              <p class="rl rl-cmd"><span class="rp-sh">$</span> jeju run p:writing/article-editor@0.1.0</p>
              <p class="rl rl-dim">run 20260708-a41f · deepseek-v4-pro · workspace ~/drafts · readOnly</p>
              <p class="rl rl-ev"><span class="ev-k">tool</span> read&nbsp;&nbsp;launch-post.md <span class="ok">→ allow</span></p>
              <p class="rl rl-ev"><span class="ev-k">tool</span> read&nbsp;&nbsp;../notes/ideas.md <span class="deny">→ deny · outside workspace</span></p>
              <p class="rl rl-ev"><span class="ev-k">model</span> deepseek-v4-pro · review pass</p>
              <p class="rl rl-json" set:html={hlJson(replayJson)} />
              <p class="rl rl-done"><span class="ok">✓</span> evidence filed — trajectory.jsonl · report.html</p>
              <p class="rl rl-cmd"><span class="rp-sh">$</span> {viewCmd}</p>
            </div>
          </figure>
      </section>

      <!-- ================= PRODUCT ================= -->
      <section class="block" id="product">
        <p class="index" data-reveal>01 — What Jeju is</p>
        <h2 data-reveal>An agent is a file.<br />A run is a record.</h2>
        <p class="block-lede" data-reveal>
          Jeju compiles a YAML manifest into a running worker. Everything the
          worker is allowed to be — and everything it did — exists as something
          you can read, diff, and version.
        </p>

        <div class="anatomy" data-reveal>
          <pre class="anatomy-yaml"><code set:html={hlYaml(manifestSnippet)} /></pre>
          <div class="pillars">
            {pillars.map((p) => (
              <article class="pillar">
                <h3>{p.title}</h3>
                <p>{p.body}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- ================= PIPELINE ================= -->
      <section class="block" id="pipeline">
        <p class="index" data-reveal>02 — From manifest to report</p>
        <h2 data-reveal>One YAML in,<br />one report out</h2>
        <p class="block-lede" data-reveal>
          Everything in between is enforced, not suggested: the manifest
          compiles into a bounded worker, every tool call passes the policy
          gate, and the whole run lands in one JSONL file
          that <code>jeju view</code> renders as a report.
        </p>

        <ol class="flow" data-reveal>
          {pipeline.map((s) => (
            <li class="flow-node">
              <span class="flow-dot" aria-hidden="true"></span>
              <span class="flow-label">{s.label}</span>
              <span class="flow-sub">{s.sub}</span>
            </li>
          ))}
        </ol>

        <div class="report-wrap" data-reveal>
          <div class="report" aria-label="Example of the report jeju view renders from a run's trajectory">
            <div class="report-head">
              <span class="report-title">report · run 20260708-a41f</span>
              <span>writing/article-editor@0.1.0</span>
            </div>
            <div class="report-sum">
              <span>verdict <b class="deny">needs_revision</b></span>
              <span>model <b>deepseek-v4-pro</b></span>
              <span>access <b>readOnly</b></span>
              <span>cost <b>$0.004</b></span>
            </div>
            <div class="report-rows">
              {reportRows.map((r) => (
                <div class="report-row">
                  <span class="report-kind">{r.kind}</span>
                  <span class="report-label">{r.label}</span>
                  <span class={`report-bar ${r.cls}`} style={`--w:${r.w}%`} aria-hidden="true"></span>
                  <span class={`report-state ${r.state === "deny" ? "deny" : "ok"}`}>{r.state}</span>
                </div>
              ))}
            </div>
            <div class="report-foot">12 events · 8.4k tokens · trajectory.jsonl saved</div>
            <svg class="stamp" viewBox="0 0 120 120" aria-hidden="true">
              <defs>
                <path id="stamp-arc" d="M 60 15 a 45 45 0 1 1 -0.01 0" fill="none" />
              </defs>
              <circle cx="60" cy="60" r="57" fill="none" stroke="currentColor" stroke-width="2.5" />
              <circle cx="60" cy="60" r="37" fill="none" stroke="currentColor" stroke-width="1" />
              <text font-size="10" letter-spacing="2.2">
                <textPath href="#stamp-arc">EVIDENCE FILED · SHA256 VERIFIED · JEJU ·</textPath>
              </text>
              <path d="M 60 48 l 7.5 13 h -15 z" fill="currentColor" />
              <text x="60" y="79" text-anchor="middle" font-size="9" letter-spacing="1.6">1947 M</text>
            </svg>
          </div>
          <div class="report-note">
            <p>
              Not a transcript — a record. <code>jeju view</code> renders the
              run's JSONL into this report: every model call, every gated tool
              call, every artifact, with cost attached. Failed runs exit
              non-zero, and the report says why.
            </p>
          </div>
        </div>
      </section>
      <!-- ================= PROBLEM ================= -->
      <section class="block" id="problem">
        <p class="index" data-reveal>03 — Why a runtime</p>
        <h2 data-reveal>Delegation without a runtime is hoping</h2>
        <div class="cols" data-reveal>
          {problems.map((p) => (
            <article>
              <h3><span class="col-key">{p.num}.</span> {p.title}</h3>
              <p>{p.body}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- ================= QUICKSTART ================= -->
      <section class="block quickstart" id="quickstart">
        <p class="index" data-reveal>04 — Quickstart · 60 seconds</p>
        <h2 data-reveal>One install, one sentence,<br />one audited run</h2>
        <p class="block-lede" data-reveal>
          All you need: a coding agent (Claude Code, Codex, Cursor — 20+
          work), a <code>DEEPSEEK_API_KEY</code>, and macOS or Linux. The
          skill bootstraps the Jeju runtime the first time your agent uses
          it; there is nothing else to set up.
        </p>
        <ol class="steps" data-reveal>
          <li>
            <div class="step-info">
              <h3><span class="step-n" aria-hidden="true">01</span>Install the skill</h3>
              <p>
                A skill is just instructions. This one teaches your agent how
                to hire Jeju workers: which one fits a request, how to install
                it, how to run it, and what evidence to hand back to you.
              </p>
            </div>
            <div class="step-do">
              <div class="step-code" data-copy-scope>
                <pre><code>{installCmd}</code></pre>
                <button type="button" data-copy>copy</button>
              </div>
              <p class="step-note">→ registers jeju-writing with your coding agent</p>
            </div>
          </li>
          <li>
            <div class="step-info">
              <h3><span class="step-n" aria-hidden="true">02</span>Say what you need</h3>
              <p>
                No new syntax — ask the way you already talk to your agent. It
                picks the cheapest capable worker, installs the package pinned
                by commit and sha256, and runs it read-only against your
                workspace. Simple asks skip review entirely.
              </p>
            </div>
            <div class="step-do">
              <div class="step-code">
                <pre><code><span class="rp">›</span> {agentPrompt}</code></pre>
              </div>
              <p class="step-note">→ routes to writing/article-editor@0.1.0 · digest verified</p>
            </div>
          </li>
          <li>
            <div class="step-info">
              <h3><span class="step-n" aria-hidden="true">03</span>Audit the evidence</h3>
              <p>
                Every delegated step prints its run id. The report shows each
                model call, what was read, what was denied, and what it
                cost — the same <code>trajectory.jsonl</code> you saw above.
                Failed runs exit non-zero, so your agent notices too.
              </p>
            </div>
            <div class="step-do">
              <div class="step-code">
                <pre><code><span class="rp-sh">$</span> {viewCmd}</code></pre>
              </div>
              <p class="step-note">→ opens the run report in your browser</p>
            </div>
          </li>
        </ol>
      </section>

      <!-- ================= BUILDER ================= -->
      <section class="block" id="builder">
        <p class="index" data-reveal>05 — Build your own</p>
        <h2 data-reveal>Your agent builds<br />the next worker</h2>
        <p class="block-lede" data-reveal>
          Ready-made workers are the fast path. The base skill
          is <code>jeju-agent-builder</code>: describe a repeated workflow, and
          your agent turns it into a new bounded worker — or tells you a plain
          script would do.
        </p>

        <div class="builder-grid" data-reveal>
          <div class="builder-steps">
            <div class="step-code">
              <pre><code><span class="rp">›</span> {builderAsk}</code></pre>
            </div>
            <ol class="builder-list">
              <li>
                <b>Decide fit.</b> Not everything deserves an agent. If a
                deterministic script is enough, the skill says so and stops.
              </li>
              <li>
                <b>Scaffold the bundle.</b> Manifest, prompt, workspace,
                README — with a model tier, tools, and step limits sized to
                the task.
              </li>
              <li>
                <b>Default to read-only.</b> Writes, shell, or network are
                declared only when the workflow demands them, and gated by
                policy either way.
              </li>
              <li>
                <b>Validate and smoke-run.</b> <code>jeju validate</code>, one
                real run, and the report to prove the worker behaves before
                you rely on it.
              </li>
            </ol>
            <div class="step-code" data-copy-scope>
              <pre><code>{builderInstall}</code></pre>
              <button type="button" data-copy>copy</button>
            </div>
          </div>
          <pre class="builder-tree"><code>{builderTree}</code></pre>
        </div>
      </section>

      <!-- ================= FIRST RECIPE ================= -->
      <section class="block" id="skill">
        <p class="index" data-reveal>06 — First recipe</p>
        <h2 data-reveal>The writing team</h2>
        <p class="block-lede" data-reveal>
          The first thing shipped on Jeju — and the builder loop's first
          product: four catalog workers behind one
          skill. <code>jeju-writing</code> turns your agent into a dispatcher —
          plain language in, the cheapest capable worker out. A review step is
          added only when stakes call for one; simple requests never pay for it.
        </p>

        <div class="router" data-reveal>
          <div class="router-row router-head" aria-hidden="true">
            <span>you say</span>
            <span></span>
            <span>routed to</span>
            <span>returns</span>
          </div>
          {routes.map((r) => (
            <div class="router-row">
              <span class="router-ask">{r.ask}</span>
              <span class="router-arrow" aria-hidden="true">→</span>
              <span class="router-worker">{r.worker}</span>
              <span class="router-returns">{r.returns}</span>
              {r.note && <p class="router-note">{r.note}</p>}
            </div>
          ))}
        </div>

        <div class="rules" data-reveal>
          {practices.map((p) => (
            <article>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </article>
          ))}
        </div>

        <div class="demo" data-reveal>
          <div class="demo-col">
            <p class="demo-label">what the skill runs for you</p>
            <pre><code>{reviewCmd}</code></pre>
          </div>
          <div class="demo-col">
            <p class="demo-label">final answer — <span class="ok">schema-validated</span></p>
            <pre><code set:html={hlJson(reviewOut)} /></pre>
